# Daily Sahih Hadith Shorts settings (all optional; these are the defaults). No secrets belong here:
# the YouTube login is token.json locally, or the YT_TOKEN_JSON secret on GitHub.
HADITH_COLLECTIONS=bukhari,muslim
NARRATION_MODE=en               # en, or ar_en with approved human Arabic recordings in ARABIC_AUDIO_DIR
TTS_ENGINE=edge                 # edge (online neural voices) or say (macOS, local tests)
ENGLISH_VOICE=en-GB-RyanNeural
ENGLISH_RATE=-6%
ARABIC_AUDIO_DIR=hadith_shorts/arabic_audio
INCLUDE_REFLECTION=false        # a one-line reflection, labelled "not part of the hadith"
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_MAX_SECONDS=75
PUBLISH_TIME=                   # e.g. 18:00 to schedule public videos; empty = publish on upload
TIMEZONE=Asia/Kolkata
YOUTUBE_PRIVACY_STATUS=private  # private (testing) | unlisted (review) | public
ENABLE_PUBLICATION=false        # true = upload; false = make and check only
OUTPUT_DIRECTORY=output/hadith
